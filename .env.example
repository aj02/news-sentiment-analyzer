# ─── LLM provider ────────────────────────────────────────────────────────────
# Which provider to use. One of: "anthropic" | "openai" | "together"
LLM_PROVIDER=anthropic

# Model identifier passed to the provider SDK.
# Anthropic examples: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5
# OpenAI examples:    gpt-4o-mini, gpt-4o
# Together examples:  meta-llama/Llama-3.3-70B-Instruct-Turbo
#                     Qwen/Qwen2.5-72B-Instruct-Turbo
#                     mistralai/Mixtral-8x7B-Instruct-v0.1
LLM_MODEL=claude-haiku-4-5

# Provider keys — set whichever matches LLM_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=

# Together AI uses an OpenAI-compatible endpoint. Override only if you're
# routing through a proxy or a self-hosted gateway.
TOGETHER_BASE_URL=https://api.together.xyz/v1

# Hard cap on tokens the model is allowed to emit per request.
LLM_MAX_OUTPUT_TOKENS=2000

# Per-call LLM timeout (seconds).
LLM_TIMEOUT_SECONDS=45

# Retry policy for transient LLM errors.
LLM_MAX_RETRIES=3

# Prompt template version to load from app/prompts/. v3 is current.
# v3 = polarity + subjectivity + certainty + emotions + aspects + quotes (Indian-context examples)
# v2 = polarity-only with confidence clamp (kept for diffability)
# v1 = baseline, no guardrails (kept for reference)
PROMPT_VERSION=v3

# ─── Fetcher ─────────────────────────────────────────────────────────────────
# HTTP timeout when downloading article HTML or RSS XML (seconds).
FETCH_TIMEOUT_SECONDS=15

# Max bytes accepted from a fetched URL (guards against huge pages).
FETCH_MAX_BYTES=5000000

# User-Agent sent by the fetcher.
FETCH_USER_AGENT=news-sentiment-analyzer/0.1 (+https://github.com/aj02/news-sentiment-analyzer)

# Hard cap on items pulled from a single RSS feed regardless of `limit`.
RSS_HARD_LIMIT=25

# ─── Cache ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Cache TTL for analysis results (seconds). 24h default.
CACHE_TTL_SECONDS=86400

# Set to "false" to disable caching entirely (useful in tests).
CACHE_ENABLED=true

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Free-form environment label, surfaced in logs.
APP_ENV=local
